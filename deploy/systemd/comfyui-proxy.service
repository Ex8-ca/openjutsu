[Unit]
Description=Comfy API proxy (port 8189 -> 8188) for Openjutsu
After=comfyui-daemon.service

[Service]
Type=simple
Environment=COMFYUI_ROOT=%h/nvme-data/.comfyui
WorkingDirectory=%h/nvme-data/.comfyui
ExecStart=%h/nvme-data/.comfyui/.venv/bin/comfy-api-proxy run --comfyui http://127.0.0.1:8188 --host 0.0.0.0 --port 8189 --comfyui-base-dir %h/nvme-data/.comfyui --allow-insecure-bind
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
