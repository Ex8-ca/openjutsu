[Unit]
Description=Openjutsu web UI (FastAPI)
After=comfyui-proxy.service

[Service]
Type=simple
Environment=COMFYUI_ROOT=%h/nvme-data/.comfyui
Environment=COMFYUI_INPUT_DIR=%h/nvme-data/.comfyui/input
Environment=COMFYUI_VENV_SITE=%h/nvme-data/.comfyui/.venv/lib/python3.13/site-packages
Environment=OPENJUTSU_OUTPUT_DIR=/home/marc/repos/openjutsu/web/outputs
WorkingDirectory=/home/marc/repos/openjutsu
ExecStart=%h/nvme-data/.comfyui/.venv/bin/python /home/marc/repos/openjutsu/web/server.py --host 0.0.0.0 --port 8765
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
