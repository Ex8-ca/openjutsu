[Unit]
Description=ComfyUI daemon for Openjutsu (port 8188)
After=network.target

[Service]
Type=simple
Environment=COMFYUI_ROOT=%h/nvme-data/.comfyui
WorkingDirectory=%h/nvme-data/.comfyui
ExecStart=%h/nvme-data/.comfyui/.venv/bin/python main.py --listen 0.0.0.0 --port 8188 --fp8_e4m3fn-unet --fp16-vae --enable-cors-header '*' --lowvram --reserve-vram 0.5 --vram-headroom 1 --log-stdout --async-offload
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
