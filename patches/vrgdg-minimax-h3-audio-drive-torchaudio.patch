-import torchaudio
+import comfy.nested_tensor
 
 
-import comfy.nested_tensor
+# Openjutsu patch: scipy-backed replacement for torchaudio.functional.resample.
+# The real torchaudio has no cu130 wheel compatible with torch 2.14.1.
+# scipy.signal.resample_poly is a numerically equivalent polyphase resampler.
+def _opj_resample_poly(waveform, orig_freq, new_freq):
+    """Drop-in for `torchaudio.functional.resample(waveform, orig_freq, new_freq)`.
+
+    Accepts the same shape conventions: [batch, channels, samples] torch
+    tensor. Returns the same dtype/device tensor resampled in place.
+    """
+    import math
+    import numpy as np
+    from scipy.signal import resample_poly
+
+    if int(orig_freq) == int(new_freq):
+        return waveform
+
+    g = math.gcd(int(orig_freq), int(new_freq))
+    up = int(new_freq) // g
+    down = int(orig_freq) // g
+
+    arr = waveform.detach().cpu().numpy()
+    orig_shape = arr.shape
+    # Flatten batch+channel into one axis for vectorized resample.
+    flat = arr.reshape(-1, orig_shape[-1])
+    resampled = np.stack(
+        [resample_poly(ch, up, down, axis=-1) for ch in flat], axis=0
+    )
+    out = resampled.reshape(*orig_shape[:-1], resampled.shape[-1])
+    return torch.from_numpy(out).to(waveform.dtype).to(waveform.device)
 
 
 def _nested_av_parts(av_latent):
@@ -100,7 +133,11 @@ class VRGDG_MiniMaxH3AudioDrive:
